{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.3-flash",
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KEY}"
      }
    }
  },
  "plugin": [
    [
      "../../packages/jev-router/src/index.ts",
      {
        "enabled": true,
        "force": true,
        "log": true,
        "typesafeApiKey": "{env:TYPESAFE_API_KEY}"
      }
    ]
  ]
}
